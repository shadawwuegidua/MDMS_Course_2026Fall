      "validation": {},
      "rules": [{"operator": "eq", "value": "no", "target_id": "q_age"}]
    },
    {
      "id": "q_fruits", "title": "你喜欢哪些水果？", "type": "multiple", "required": true,
      "options": [{"id": "apple", "text": "苹果"}, {"id": "banana", "text": "香蕉"}, {"id": "orange", "text": "橙子"}],
      "validation": {"min_choices": 1, "max_choices": 2},
      "rules": [{"operator": "contains", "value": "orange", "target_id": "q_feedback"}]
    },
    {
      "id": "q_age", "title": "你的年龄", "type": "number", "required": true,
      "options": [], "validation": {"min_value": 0, "max_value": 120, "integer_only": true},
      "rules": [{"operator": "lt", "value": 18, "target_id": "q_feedback"}]
    },
    {
      "id": "q_advice", "title": "你对课程学习有什么建议？", "type": "text", "required": true,
      "options": [], "validation": {"min_length": 2, "max_length": 60}, "rules": []
    },
    {
      "id": "q_feedback", "title": "其他意见（可留空）", "type": "text", "required": false,
      "options": [], "validation": {"max_length": 100}, "rules": []
    }
  ]
}
